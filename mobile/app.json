{
  "expo": {
    "name": "StageFront Live",
    "slug": "stagefront-live",
    "scheme": "stagefront",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stagefront.live",
      "infoPlist": {
        "NSCameraUsageDescription": "StageFront uses your camera when you join a live stage.",
        "NSMicrophoneUsageDescription": "StageFront uses your microphone when you join a live stage."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
      ,"package": "com.stagefront.live"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
